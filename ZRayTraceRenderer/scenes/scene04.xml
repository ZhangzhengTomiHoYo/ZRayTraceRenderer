<Scene>
    <Camera>
        <Position>0, 0.6, -2.58</Position>
        <Target>0, 0.61, 3</Target>
        <Up>0, 1, 0</Up>
        <NearZ>0.1</NearZ>
        <FarZ>1000</FarZ>
        <Fov>45</Fov>
    </Camera>

    <Materials>
        <Material>
            <Name>M_Lambert_Red</Name>
            <Type>Lambert</Type>
            <Albedo>0.6, 0.2, 0.2</Albedo>
        </Material>
        <Material>
            <Name>M_Lambert_Blue</Name>
            <Type>Lambert</Type>
            <Albedo>0.2, 0.2, 0.6</Albedo>
        </Material>
        <Material>
            <Name>M_Lambert_Gray</Name>
            <Type>Lambert</Type>
            <Albedo>0.5, 0.5, 0.5</Albedo>
        </Material>
    </Materials>

    <SceneObjects>
        <!-- left sphere -->
        <SceneObject>
            <Transform>
                <Position>-0.4, 0.3, 0.3</Position>
                <Rotation>0, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Sphere>
                    <Radius>0.3</Radius>
                </Sphere>
            </Primitives>
        </SceneObject>

        <!-- right sphere -->
        <SceneObject>
            <Transform>
                <Position>0.4, 0.3, -0.3</Position>
                <Rotation>0, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Sphere>
                    <Radius>0.3</Radius>
                </Sphere>
            </Primitives>
        </SceneObject>

        <!-- ground -->
        <SceneObject>
            <Transform>
                <Position>0, 0, 0</Position>
                <Rotation>-90, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -1, 0</Vertex>
                    <Vertex>1, -1, 0</Vertex>
                    <Vertex>1, 1, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -1, 0</Vertex>
                    <Vertex>1, 1, 0</Vertex>
                    <Vertex>-1, 1, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- ceiling -->
        <SceneObject>
            <Transform>
                <Position>0, 1.5, 0</Position>
                <Rotation>90, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -1, 0</Vertex>
                    <Vertex>1, -1, 0</Vertex>
                    <Vertex>1, 1, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -1, 0</Vertex>
                    <Vertex>1, 1, 0</Vertex>
                    <Vertex>-1, 1, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- left wall -->
        <SceneObject>
            <Transform>
                <Position>-1, 0.75, 0</Position>
                <Rotation>0, 90, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Red</Material>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                    <Vertex>-1, 0.75, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- right wall -->
        <SceneObject>
            <Transform>
                <Position>1, 0.75, 0</Position>
                <Rotation>0, -90, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Blue</Material>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                    <Vertex>-1, 0.75, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- back wall -->
        <SceneObject>
            <Transform>
                <Position>0, 0.75, 1</Position>
                <Rotation>180, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Material>M_Lambert_Gray</Material>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                    <Vertex>-1, 0.75, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>
    </SceneObjects>

    <Lights>
        <!-- 方向光 -->
        <!-- <DirectionalLight>
            <Direction>0, -1, 0</Direction>
            <Radiance>1, 1, 1</Radiance>
        </DirectionalLight> -->

        <!-- 点光源 -->
        <PointLight>
            <Position>0, 1, 0</Position>
            <Intensity>1, 1, 1</Intensity>
            <Attenuations>3, 0, 0</Attenuations> <!-- A, B, C -->
        </PointLight>

        <!-- 聚光灯，内外角度以度为单位 -->
        <SpotLight>
            <Position>-0.8, 0.9, 0</Position>
            <Direction>2, -1, 0</Direction>
            <Intensity>0.2, 1.2, 1</Intensity>
            <InnerAngle>15</InnerAngle>
            <OuterAngle>30</OuterAngle>
            <Attenuations>1, 0, 0</Attenuations> 
        </SpotLight>
    </Lights>
</Scene>
